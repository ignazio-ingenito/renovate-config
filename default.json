{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "platformAutomerge": false,
  "rebaseWhen": "conflicted",
  "internalChecksFilter": "strict",
  "prCreation": "immediate",
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "30 days"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/skunklabs-uk/developer-workspace",
        "harbor.lab.skunklabs.uk/private-ghcr/skunklabs-uk/developer-workspace",
        "ghcr.io/ignazio-ingenito/aeris",
        "harbor.lab.skunklabs.uk/private-ghcr/ignazio-ingenito/aeris",
        "ghcr.io/skunklabs-uk/skunklabs",
        "harbor.lab.skunklabs.uk/private-ghcr/skunklabs-uk/skunklabs",
        "ghcr.io/skunklabs-uk/baialupo.com",
        "harbor.lab.skunklabs.uk/private-ghcr/skunklabs-uk/baialupo.com",
        "ghcr.io/ignazio-ingenito/iwant",
        "harbor.lab.skunklabs.uk/private-ghcr/ignazio-ingenito/iwant",
        "ghcr.io/ignazio-ingenito/iwant-migrator",
        "harbor.lab.skunklabs.uk/private-ghcr/ignazio-ingenito/iwant-migrator",
        "ghcr.io/skunklabs-uk/prosignal",
        "harbor.lab.skunklabs.uk/private-ghcr/skunklabs-uk/prosignal",
        "ghcr.io/skunklabs-uk/club-aviazione-popolare-web",
        "harbor.lab.skunklabs.uk/private-ghcr/skunklabs-uk/club-aviazione-popolare-web",
        "ghcr.io/skunklabs-uk/club-aviazione-popolare-cms",
        "harbor.lab.skunklabs.uk/private-ghcr/skunklabs-uk/club-aviazione-popolare-cms"
      ],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{2})\\.(?<patch>\\d{2})_(?<build>\\d+)$",
      "minimumReleaseAge": null
    }
  ]
}
